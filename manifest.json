{
    "manifest_version": 3,
    "name": "Projetor Igreja",
    "version": "2.0",
    "description": "Sistema de projeção profissional para YouTube em igrejas.",
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "system.display"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/images/16.png",
            "48": "assets/images/48.png",
            "128": "assets/images/128.png"
        }
    },
    "icons": {
        "16": "assets/images/16.png",
        "48": "assets/images/48.png",
        "128": "assets/images/128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/watch*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "assets/css/cleaner.css"
            ],
            "run_at": "document_idle"
        }
    ]
}