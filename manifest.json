{
    "manifest_version": 3,
    "name": "Projetor Igreja",
    "version": "3.5",
    "description": "Sistema de projeção profissional para YouTube em igrejas.",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "tabs",
        "scripting",
        "system.display",
        "downloads",
        "alarms",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/images/16.png",
            "48": "assets/images/48.png",
            "128": "assets/images/128.png"
        }
    },
    "icons": {
        "16": "assets/images/16.png",
        "48": "assets/images/48.png",
        "128": "assets/images/128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "projetor_midia.html",
                "projetor_midia.js",
                "projetor_time.html",
                "projetor_time.js",
                "update.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "host_permissions": [
        "<all_urls>",
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://bolls.life/*",
        "https://api.github.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/watch*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "assets/css/cleaner.css"
            ],
            "run_at": "document_idle"
        }
    ]
}